# fnm upgrade with global package migration
fnm-upgrade() {
  local old=$(node -v)
  fnm install "$1" && fnm use "$1"
  local pkgs=$(fnm exec --using="${old#v}" npm ls -g --depth=0 --json 2>/dev/null | \
    node -e "const pkgs=Object.keys(JSON.parse(require('fs').readFileSync(0,'utf8')).dependencies).filter(p=>!['npm','corepack'].includes(p)); if(pkgs.length) console.log(pkgs.join(' '))")
  if [[ -n "$pkgs" ]]; then
    echo "Reinstalling global packages: $pkgs"
    npm install -g $pkgs
  fi
  fnm default "$1"
  echo "Upgraded from $old to $(node -v)"
}
