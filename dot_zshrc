# Shift+Select and Shift+Enter support for zsh
bindkey -e  # Ensure emacs mode

# Visual selection highlight color (standout/reverse video)
zle_highlight=(region:standout)

# Shift+Select functions - true visual selection like GUI editors
function shift-select-left() {
    ((REGION_ACTIVE)) || zle set-mark-command
    zle backward-char
}
zle -N shift-select-left

function shift-select-right() {
    ((REGION_ACTIVE)) || zle set-mark-command
    zle forward-char
}
zle -N shift-select-right

function shift-select-up() {
    ((REGION_ACTIVE)) || zle set-mark-command
    zle up-line-or-history
}
zle -N shift-select-up

function shift-select-down() {
    ((REGION_ACTIVE)) || zle set-mark-command
    zle down-line-or-history
}
zle -N shift-select-down

function shift-select-home() {
    ((REGION_ACTIVE)) || zle set-mark-command
    zle beginning-of-line
}
zle -N shift-select-home

function shift-select-end() {
    ((REGION_ACTIVE)) || zle set-mark-command
    zle end-of-line
}
zle -N shift-select-end

function shift-select-word-left() {
    ((REGION_ACTIVE)) || zle set-mark-command
    zle backward-word
}
zle -N shift-select-word-left

function shift-select-word-right() {
    ((REGION_ACTIVE)) || zle set-mark-command
    zle forward-word
}
zle -N shift-select-word-right

# Deselect function - clears selection state
function deselect() {
    REGION_ACTIVE=0
    zle -f vichange  # Reset any pending state
}
zle -N deselect

# Wrapper to deselect before self-insert (typing deselects)
function self-insert-deselect() {
    if ((REGION_ACTIVE)); then
        # Delete selected region, then insert
        zle kill-region
    fi
    zle .self-insert
}
zle -N self-insert self-insert-deselect

# Deselect on normal movement
function deselect-and-left() {
    REGION_ACTIVE=0
    zle backward-char
}
zle -N deselect-and-left

function deselect-and-right() {
    REGION_ACTIVE=0
    zle forward-char
}
zle -N deselect-and-right

function deselect-and-up() {
    REGION_ACTIVE=0
    zle up-line-or-history
}
zle -N deselect-and-up

function deselect-and-down() {
    REGION_ACTIVE=0
    zle down-line-or-history
}
zle -N deselect-and-down

# Bind shift+arrow keys to selection functions
bindkey '\e[1;2D' shift-select-left      # Shift+Left
bindkey '\e[1;2C' shift-select-right     # Shift+Right
bindkey '\e[1;2A' shift-select-up        # Shift+Up
bindkey '\e[1;2B' shift-select-down      # Shift+Down
bindkey '\e[1;2H' shift-select-home      # Shift+Home
bindkey '\e[1;2F' shift-select-end       # Shift+End
bindkey '\e[1;6D' shift-select-word-left  # Ctrl+Shift+Left (select word)
bindkey '\e[1;6C' shift-select-word-right # Ctrl+Shift+Right (select word)

# Normal arrow keys deselect
bindkey '\e[D' deselect-and-left
bindkey '\e[C' deselect-and-right
bindkey '\e[A' deselect-and-up
bindkey '\e[B' deselect-and-down

# Escape key deselects (useful for getting out of stuck state)
bindkey '\e' deselect

# Shift+Enter for newline without executing (multi-line editing)
function _insert_newline() {
    REGION_ACTIVE=0
    LBUFFER+=$'\n'
}
zle -N _insert_newline
bindkey '\e[13;2u' _insert_newline

